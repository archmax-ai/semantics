---
import { Icon } from "@astrojs/starlight/components";

const PAGE_TITLE_ID = "_top";
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const subtitle = data.description;
---

<section class="archmax-hero not-content">
  <div class="archmax-hero__gradient" aria-hidden="true"></div>
  <div class="archmax-hero__inner">
    {
      tagline && (
        <p class="archmax-hero__eyebrow">
          <span class="archmax-hero__slashes">{"// "}</span>
          <Fragment set:html={tagline} />
        </p>
      )
    }
    <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
    {subtitle && <p class="archmax-hero__subtitle">{subtitle}</p>}
    {
      actions.length > 0 && (
        <div class="archmax-hero__actions">
          {actions.map(
            ({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
              <a
                {href}
                class:list={[
                  "archmax-hero__action",
                  variant === "primary"
                    ? "archmax-hero__action--primary"
                    : "archmax-hero__action--secondary",
                  className,
                ]}
                {...attrs}
              >
                {text}
                {icon?.name && <Icon name={icon.name} size="1rem" />}
                {icon?.html && <Fragment set:html={icon.html} />}
              </a>
            ),
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .archmax-hero {
    position: relative;
    overflow: hidden;
    margin-inline: calc(50% - 50vw);
    margin-top: calc(-1 * (var(--sl-nav-height) + 1.5rem));
    padding: calc(var(--sl-nav-height) + clamp(3rem, 8vw, 6rem)) var(--sl-content-pad-x)
      clamp(3rem, 8vw, 6rem);
    color: #000;
  }

  .archmax-hero__gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      -45deg,
      var(--gradient-1),
      var(--gradient-2),
      var(--gradient-3),
      var(--gradient-4),
      var(--gradient-5),
      var(--gradient-6),
      var(--gradient-7),
      var(--gradient-6),
      var(--gradient-5),
      var(--gradient-4),
      var(--gradient-3),
      var(--gradient-2),
      var(--gradient-1)
    );
    background-size: 400% 400%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .archmax-hero__gradient {
      animation: archmax-flow 40s ease infinite;
    }
  }

  @keyframes archmax-flow {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  .archmax-hero__inner {
    position: relative;
    max-width: var(--sl-content-width);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .archmax-hero__eyebrow {
    margin: 0;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-base);
    color: rgb(0 0 0 / 0.55);
  }
  .archmax-hero__slashes {
    color: rgb(0 0 0 / 0.35);
  }

  h1 {
    margin: 0;
    max-width: 22ch;
    font-size: clamp(var(--sl-text-4xl), calc(1rem + 4vw), var(--sl-text-6xl));
    line-height: 1.05;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: #000;
  }

  .archmax-hero__subtitle {
    margin: 0;
    max-width: 42rem;
    font-size: var(--sl-text-lg);
    line-height: 1.6;
    color: rgb(0 0 0 / 0.7);
  }

  .archmax-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .archmax-hero__action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.5rem;
    padding-inline: 1.5rem;
    border-radius: 9999px;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.15s, opacity 0.15s;
  }
  .archmax-hero__action--primary {
    background-color: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
  }
  .archmax-hero__action--primary:hover {
    opacity: 0.9;
  }
  .archmax-hero__action--secondary {
    background-color: rgb(0 0 0 / 0.08);
    color: #000;
  }
  .archmax-hero__action--secondary:hover {
    background-color: rgb(0 0 0 / 0.14);
  }

  :global(:root[data-theme="dark"]) .archmax-hero,
  :global(:root[data-theme="dark"]) .archmax-hero h1,
  :global(:root[data-theme="dark"]) .archmax-hero__action--secondary {
    color: hsl(var(--foreground));
  }
  :global(:root[data-theme="dark"]) .archmax-hero__eyebrow {
    color: hsl(var(--foreground) / 0.55);
  }
  :global(:root[data-theme="dark"]) .archmax-hero__slashes {
    color: hsl(var(--foreground) / 0.35);
  }
  :global(:root[data-theme="dark"]) .archmax-hero__subtitle {
    color: hsl(var(--foreground) / 0.7);
  }
  :global(:root[data-theme="dark"]) .archmax-hero__action--secondary {
    background-color: hsl(var(--foreground) / 0.08);
  }
  :global(:root[data-theme="dark"]) .archmax-hero__action--secondary:hover {
    background-color: hsl(var(--foreground) / 0.14);
  }
</style>
