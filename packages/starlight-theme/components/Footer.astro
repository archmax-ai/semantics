---
import EditLink from "virtual:starlight/components/EditLink";
import LastUpdated from "virtual:starlight/components/LastUpdated";
import Pagination from "virtual:starlight/components/Pagination";
import { Icon } from "@astrojs/starlight/components";
import options from "virtual:archmax-starlight-theme/options";

const year = new Date().getFullYear();
const websiteLabel = options.links.website.replace(/^https?:\/\//, "").replace(/\/$/, "");
const links = [
  { label: websiteLabel, href: options.links.website, external: true },
  options.links.github ? { label: "GitHub", href: options.links.github, external: true } : null,
  { label: "Imprint", href: options.links.imprint, external: false },
  { label: "Privacy", href: options.links.privacy, external: false },
].filter((link): link is { label: string; href: string; external: boolean } => link !== null);
const palette = [1, 2, 3, 4, 5, 6, 7];
---

<footer class="archmax-footer not-content">
  <div class="archmax-footer__meta">
    <EditLink />
    <LastUpdated />
  </div>
  <Pagination />

  <div class="archmax-footer__brand archmax-dark">
    <div class="archmax-footer__row">
      <div class="archmax-footer__identity">
        <p class="archmax-footer__wordmark" translate="no">
          archmax
          {options.product && <span class="archmax-footer__product">{options.product}</span>}
        </p>
        <p class="archmax-footer__tagline">{options.tagline}</p>
      </div>
      <nav class="archmax-footer__links" aria-label="archmax">
        {
          links.map((link) => (
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
            >
              {link.label}
              {link.external && <Icon name="external" size="0.8125rem" />}
            </a>
          ))
        }
      </nav>
    </div>
    <div class="archmax-footer__bottom">
      <div class="archmax-footer__palette" aria-hidden="true">
        {palette.map((i) => <span style={`background-color: var(--ci-${i})`} />)}
        <span class="archmax-footer__palette-label">ci-palette</span>
      </div>
      <p class="archmax-footer__copyright">
        © {year} {options.copyrightHolder}. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .archmax-footer {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .archmax-footer__meta {
    display: flex;
    gap: 0.75rem 3rem;
    justify-content: space-between;
    flex-wrap: wrap;
    margin-top: 3rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .archmax-footer__meta:empty {
    display: none;
  }
  .archmax-footer__meta > :global(p:only-child) {
    margin-inline-start: auto;
  }

  .archmax-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin-top: 2rem;
    padding: 2.5rem 2rem;
    border-radius: 0.75rem;
    background-color: hsl(var(--background));
    color: hsl(var(--foreground));
  }
  :global(:root[data-theme="dark"]) .archmax-footer__brand {
    background-color: hsl(var(--card));
  }
  :global(:root:not([data-has-sidebar])) .archmax-footer__brand {
    margin-inline: calc(50% - 50vw);
    border-radius: 0;
    padding-inline: max(var(--sl-content-pad-x), calc(50vw - var(--sl-content-width) / 2));
    padding-block: 4rem 3rem;
  }

  .archmax-footer__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem 3rem;
  }

  .archmax-footer__identity {
    max-width: 20rem;
  }
  .archmax-footer__wordmark {
    margin: 0;
    font-size: var(--sl-text-base);
    font-weight: 600;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .archmax-footer__product {
    font-weight: 500;
    color: hsl(var(--muted-foreground));
  }
  .archmax-footer__tagline {
    margin: 0.5rem 0 0;
    font-size: var(--sl-text-base);
    line-height: 1.5;
    color: hsl(var(--muted-foreground));
  }

  .archmax-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    align-content: flex-start;
  }
  .archmax-footer__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--sl-text-base);
    color: hsl(var(--muted-foreground));
    text-decoration: none;
    transition: color 0.15s;
  }
  .archmax-footer__links a:hover {
    color: hsl(var(--foreground));
  }

  .archmax-footer__bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .archmax-footer__palette {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .archmax-footer__palette > span:not(.archmax-footer__palette-label) {
    display: block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
  }
  .archmax-footer__palette-label,
  .archmax-footer__copyright {
    margin: 0;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
    color: hsl(var(--muted-foreground));
  }
  .archmax-footer__palette-label {
    margin-inline-start: 0.5rem;
  }
</style>
