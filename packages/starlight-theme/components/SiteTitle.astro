---
import { logos } from "virtual:starlight/user-images";
import config from "virtual:starlight/user-config";
import options from "virtual:archmax-starlight-theme/options";

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const hasLogo = Boolean(config.logo && logos.dark);
---

<a href={siteTitleHref} class="site-title sl-flex">
  {
    hasLogo && config.logo && logos.dark ? (
      <>
        <img
          class:list={{ "light:sl-hidden print:hidden": !("src" in config.logo) }}
          alt={config.logo.alt}
          src={logos.dark.src}
          width={logos.dark.width}
          height={logos.dark.height}
        />
        {!("src" in config.logo) && (
          <img
            class="dark:sl-hidden print:block"
            alt={config.logo.alt}
            src={logos.light?.src}
            width={logos.light?.width}
            height={logos.light?.height}
          />
        )}
      </>
    ) : (
      <span class="wordmark" translate="no">
        archmax
      </span>
    )
  }
  {hasLogo && <span class="sr-only">{siteTitle}</span>}
  {
    options.product && (
      <span class="product-name" translate="no">
        {options.product}
      </span>
    )
  }
  <span class="version-badge" translate="no">v{options.version}</span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: 0.5rem;
    font-size: var(--sl-text-base);
    font-weight: 600;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }
  .site-title span {
    overflow: hidden;
  }
  .wordmark {
    letter-spacing: -0.01em;
  }
  .product-name {
    font-weight: 500;
    color: var(--sl-color-gray-3);
  }
  .version-badge {
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
    line-height: 1;
    font-weight: 500;
    padding: 0.2rem 0.45rem;
    border-radius: 9999px;
    background-color: hsl(var(--muted));
    color: hsl(var(--muted-foreground));
  }
  img {
    height: 1.125rem;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: 0 50%;
  }
</style>
